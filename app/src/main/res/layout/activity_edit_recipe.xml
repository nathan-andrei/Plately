<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/editButtonCancel"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="72dp"
                android:layout_weight="1"
                android:backgroundTint="#E0E0E0"
                android:shape="rectangle"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#000000" />

            <Button
                android:id="@+id/editButtonSave"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:backgroundTint="#D32F2F"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <TextView
            android:id="@+id/textViewEditRecipeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Edit Recipe"
            android:textColor="#D32F2F"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <EditText
                android:id="@+id/editEditTextRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:backgroundTint="#B0B0B0"
                android:hint="Enter recipe name"
                android:inputType="text"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/editTextViewImageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Image"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/editButtonImageInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:srcCompat="@drawable/baseline_navigate_next_24" />

            </LinearLayout>

            <ImageView
                android:id="@+id/editImageViewSelected"
                android:layout_width="200dp"
                android:layout_height="200dp"
                android:layout_gravity="start"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="16dp"
                android:scaleType="centerCrop"
                android:background="@android:color/darker_gray"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="0dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/editTextViewTagInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add tags"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/editButtonTagInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:srcCompat="@drawable/baseline_navigate_next_24" />
            </LinearLayout>

            <TextView
                android:id="@+id/editTextViewSelectedTags"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:textColor="#757575"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/editTextViewGroupInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Add to a group"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/editButtonGroupInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    app:srcCompat="@drawable/baseline_navigate_next_24" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/editTextViewServesInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/baseline_people_24"
                    android:text="Serves"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editEditTextServesInput"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#B0B0B0"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/editTextViewPrepTimeInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/baseline_access_time_24"
                    android:text="Prep Time (in min)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editEditTextPrepTimeInput"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#B0B0B0"
                    android:hint="min"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/editTextViewCookTimeInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableStart="@drawable/baseline_access_time_24"
                    android:text="Cook Time (in min)"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editEditTextCookTimeInput"
                    android:layout_width="50dp"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#B0B0B0"
                    android:hint="min"
                    android:inputType="number" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/editTextViewSourceInput"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="Source"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/editEditTextSourceInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:backgroundTint="#B0B0B0"
                    android:hint="Enter source (optional)"
                    android:inputType="text"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/editTextViewIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Ingredients"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editEditTextIngredientsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:background="@drawable/edit_text_border"
                android:gravity="top|start"
                android:hint="Add each ingredient on a new line"
                android:inputType="textMultiLine"
                android:lines="4"
                android:padding="12dp"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/editTextViewInstructions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="Instructions"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editEditTextInstructionsInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Add each instruction on a new line"
                android:inputType="textMultiLine"
                android:lines="6"
                android:gravity="top|start"
                android:padding="12dp"
                android:background="@drawable/edit_text_border"
                android:scrollbars="vertical" />

            <TextView
                android:id="@+id/editTextViewNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:text="Notes"
                android:textSize="20sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/editEditTextNotesInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:background="@drawable/edit_text_border"
                android:hint="Add a note (optional)"
                android:inputType="text"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
